{
  "name": "@frontendnetwork/veganify",
  "version": "2.1.45",
  "description": "A wrapper for the official Veganify API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "check-types": "bun check --no-script",
    "format:check": "bun fmt --check",
    "format": "bun fmt",
    "check": "bun run lint && bun run format:check && bun run check-types && bun test",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontendnetwork/veganify-api-wrapper.git"
  },
  "keywords": [
    "API",
    "Vegan",
    "Veganify",
    "React",
    "TypeScript"
  ],
  "author": "FrontEndNet.work, Philip Brembeck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frontendnetwork/veganify-api-wrapper/issues"
  },
  "homepage": "https://github.com/frontendnetwork/veganify-api-wrapper#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.4.5",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "ultracite": "8.3.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
