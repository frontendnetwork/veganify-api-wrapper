{
  "name": "@frontendnetwork/veganify",
  "version": "2.1.45",
  "description": "A wrapper for the official Veganify API",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm"
  ],
  "scripts": {
    "test": "bun test",
    "clean": "rm -rf dist",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "format:check": "bun fmt --check",
    "format": "bun fmt",
    "check": "bun run lint && bun run format:check && bun run check-types && bun test",
    "prebuild": "bun run check && npm run clean",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/add-esm-extensions.mjs && echo '{\"type\":\"module\"}' > dist/esm/package.json",
    "build": "npm run build:cjs && npm run build:esm",
    "lint": "eslint lib",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontendnetwork/veganify-api-wrapper.git"
  },
  "keywords": [
    "API",
    "Vegan",
    "Veganify",
    "React",
    "TypeScript"
  ],
  "author": "FrontEndNet.work, Philip Brembeck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/frontendnetwork/veganify-api-wrapper/issues"
  },
  "homepage": "https://github.com/frontendnetwork/veganify-api-wrapper#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.2",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "typescript": "^6.0.3",
    "ultracite": "8.3.1",
    "zod": "^4.6.5"
  }
}
